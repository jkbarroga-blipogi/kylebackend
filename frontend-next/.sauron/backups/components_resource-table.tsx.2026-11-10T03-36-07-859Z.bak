"use client";

import { useMemo, useState } from "react";
import { Button } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { fieldValue, recordName, type Row } from "@/lib/records";
import { canWrite, getResource, type Resource } from "@/lib/resources";

type ResourceTableProps = {
  resource: Resource;
  rows: Row[];
  references?: Record<string, Row[]>;
  role: string;
  onOpen: (resource: Resource, row: Row, mode: "view" | "edit") => void;
  onDelete: (resource: Resource, row: Row) => void;
};

function Badge({ value }: { value: unknown }) {
  const status = String(value ?? "Not set");
  const key = status.trim().toLowerCase();
  const color = ["available", "adopted", "completed", "approved"].includes(key)
    ? "status-positive"
    : ["pending", "review", "quarantine"].includes(key)
      ? "status-warning"
      : ["rejected", "cancelled", "canceled", "deceased"].includes(key)
        ? "status-negative"
        : key === "admin"
          ? "status-neutral"
          : "status-neutral";
  return (
    <span className={`inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs leading-relaxed ${color}`}>
      <span className="size-1.5 rounded-full bg-current" aria-hidden="true" />
      {status}
    </span>
  );
}

export function ResourceTable({ resource, rows, references = {}, role, onOpen, onDelete }: ResourceTableProps) {
  const [query, setQuery] = useState("");
  const writable = canWrite(role, resource.key);
  const filtered = useMemo(() => {
    const needle = query.trim().toLowerCase();
    if (!needle) return rows;
    return rows.filter((row) => JSON.stringify(row).toLowerCase().includes(needle));
  }, [rows, query]);

  const labelFor = (name: string) =>
    resource.fields.find((field) => field.name === name)?.label ?? name.replace(/_/g, " ");

  function displayValue(name: string, row: Row): string {
    const field = resource.fields.find((entry) => entry.name === name);
    if (field?.ref) {
      const refResource = getResource(field.ref);
      const related = references[field.ref]?.find(
        (item) => String(item[refResource?.idKey ?? "id"]) === String(row[name]),
      );
      if (related && refResource) return recordName(refResource, related);
    }
    return fieldValue(resource, row, name, references);
  }

  return (
    <Card>
      <div className="flex flex-wrap items-center justify-between gap-4 border-b border-border p-5">
        <div className="grid min-w-0 flex-1 gap-2 md:max-w-[340px]">
          <Label htmlFor="search" className="sr-only">Search records</Label>
          <Input id="search" type="search" placeholder="Search records..." value={query} onChange={(event) => setQuery(event.target.value)} />
        </div>
        <p className="text-sm text-muted-foreground" aria-live="polite">
          {rows.length} {rows.length === 1 ? "record" : "records"}
          {query ? ` - Showing ${filtered.length} of ${rows.length}` : ""}
        </p>
      </div>
      {filtered.length === 0 ? (
        <div className="p-12 text-center">
          <h2 className="text-lg font-semibold">{query ? "No matching records" : `No ${resource.label.toLowerCase()} yet`}</h2>
          <p className="mx-auto mt-2 max-w-[460px] text-sm leading-relaxed text-muted-foreground">
            {query ? "Clear your search or try another term." : writable ? `Add a ${resource.singular} to get started.` : "No records are available to display."}
          </p>
          {query ? (
            <Button type="button" variant="secondary" className="mt-4" onClick={() => setQuery("")}>
              Clear search
            </Button>
          ) : null}
        </div>
      ) : (
        <div className="overflow-x-auto" role="region" aria-label={`${resource.label} table, scroll horizontally for more columns`} tabIndex={0}>
          <table className="w-full min-w-[650px] border-collapse text-left text-sm">
            <caption className="sr-only">{resource.label}: {filtered.length} records</caption>
            <thead>
              <tr>
                {resource.columns.map((name) => (
                  <th key={name} scope="col" className="border-b border-border bg-secondary/60 px-5 py-3.5 font-medium text-muted-foreground">
                    {labelFor(name)}
                  </th>
                ))}
                <th scope="col" className="border-b border-border bg-secondary/60 px-5 py-3.5">
                  <span className="sr-only">Actions</span>
                </th>
              </tr>
            </thead>
            <tbody>
              {filtered.map((row) => {
                const id = row[resource.idKey] as number;
                const identity = `${recordName(resource, row)} ${id}`;
                return (
                  <tr key={id} className="hover:bg-secondary/50">
                    {resource.columns.map((name, index) => {
                      const value = displayValue(name, row);
                      return (
                        <td key={name} className="max-w-[280px] border-b border-border align-middle break-words px-5 py-5">
                          {name.includes("status") || name === "role" ? (
                            <Badge value={row[name]} />
                          ) : index === 0 ? (
                            <span className="flex items-center gap-3">
                              {resource.key === "animal" && typeof row.image_url === "string" && row.image_url ? (
                                // eslint-disable-next-line @next/next/no-img-element
                                <img src={row.image_url} alt="" className="size-10 shrink-0 rounded-lg border border-border object-cover" />
                              ) : null}
                              <span>
                                <strong className="block font-medium">{value}</strong>
                                <small className="mt-1 block text-xs text-muted-foreground tabular-nums">{id}</small>
                              </span>
                            </span>
                          ) : (
                            value
                          )}
                        </td>
                      );
                    })}
                    <td className="border-b border-border px-5 py-5">
                      <div className="flex justify-end gap-1">
                        <Button type="button" variant="ghost" size="sm" aria-label={`View ${identity}`} onClick={() => onOpen(resource, row, "view")}>
                          View
                        </Button>
                        {writable ? (
                          <>
                            <Button type="button" variant="ghost" size="sm" aria-label={`Edit ${identity}`} onClick={() => onOpen(resource, row, "edit")}>
                              Edit
                            </Button>
                            <Button type="button" variant="ghost" size="sm" className="text-destructive" aria-label={`Delete ${identity}`} onClick={() => onDelete(resource, row)}>
                              Delete
                            </Button>
                          </>
                        ) : null}
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </Card>
  );
}
