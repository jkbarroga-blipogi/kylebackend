"use client";

import { useState } from "react";
import { ResourcePage } from "@/components/resource-page";
import { useAuth } from "@/lib/auth-context";
import { animalTabs, canAccess, type AnimalTabKey } from "@/lib/resources";

export function AnimalPage() {
  const { session } = useAuth();
  const [tab, setTab] = useState<AnimalTabKey>("animal");
  const role = session?.role ?? "";
  const visibleTabs = animalTabs.filter((key) => canAccess(role, key));

  return (
    <div className="grid gap-6">
      <div role="tablist" aria-label="Animal records" className="flex flex-wrap gap-2 border-b border-border">
        {visibleTabs.map((key) => {
          const active = tab === key;
          const label = key === "animal" ? "Animals" : key === "species" ? "Species" : "Breeds";
          return (
            <button
              key={key}
              type="button"
              role="tab"
              aria-selected={active}
              onClick={() => setTab(key)}
              className={
                active
                  ? "min-h-11 border-b-2 border-primary px-4 text-sm font-semibold text-primary"
                  : "min-h-11 border-b-2 border-transparent px-4 text-sm text-muted-foreground hover:text-foreground"
              }
            >
              {label}
            </button>
          );
        })}
      </div>
      <ResourcePage key={tab} resourceKey={tab} />
    </div>
  );
}
