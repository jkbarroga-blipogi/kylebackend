@import "tailwindcss";

:root {
  color-scheme: dark;
  --bg: #0a0d13;
  --panel: #12161e;
  --panel-2: #191f2a;
  --panel-3: #212834;
  --text: #e8ecf4;
  --muted: #a7b2c8;
  --line: #262f3d;
  --control-line: #64748b;
  --accent: #4f46e5;
  --accent-2: #a5adff;
  --button-primary: #4f46e5;
  --button-primary-hover: #4338ca;
  --focus: #38bdf8;
  --danger: #fb5f77;
  --ok: #30c48d;
  --amber: #fbbf24;
  --radius: 12px;
  --background: var(--bg);
  --foreground: var(--text);
  --card: var(--panel);
  --card-foreground: var(--text);
  --primary: var(--accent);
  --primary-foreground: #ffffff;
  --secondary: var(--panel-2);
  --secondary-foreground: var(--text);
  --muted-foreground: var(--muted);
  --border: var(--line);
  --input: var(--control-line);
  --ring: var(--focus);
  --destructive: var(--danger);
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted-foreground: var(--muted-foreground);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);
  --color-destructive: var(--destructive);
  --font-sans: "Segoe UI", Arial, sans-serif;
}

html { scroll-behavior: smooth; }
body { margin: 0; background: var(--bg); color: var(--text); font-family: "Segoe UI", Arial, sans-serif; -webkit-font-smoothing: antialiased; }
::selection { background: #3d386c; color: #f0efff; }
:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
button, a, input, select, textarea { -webkit-tap-highlight-color: transparent; }
button:not(:disabled), a { cursor: pointer; }
h1 { font-size: clamp(1.75rem, 2.6vw, 2.25rem); line-height: 1.2; letter-spacing: -0.045em; }
input, select, textarea { accent-color: var(--primary); }

.auth-page { display: grid; min-height: 100dvh; background: var(--bg); }
.auth-story { display: none; background: #12161e; border-color: var(--border); }
.auth-story h2 { font-size: clamp(2.75rem, 4.1vw, 4.25rem); line-height: 1.12; letter-spacing: -0.055em; font-weight: 450; }
.auth-story-content { width: 100%; max-width: 520px; margin-block: auto; padding-block: 64px; }
.auth-story .care-step { display: flex; align-items: center; gap: 20px; padding-block: 20px; border-bottom: 1px solid #262f3d; }
.auth-story .care-number { display: grid; width: 30px; height: 30px; flex-shrink: 0; place-items: center; border: 1px solid #4c4a82; border-radius: 50%; font-size: 11px; color: var(--accent-2); }
.auth-main { display: flex; min-width: 0; flex-direction: column; align-items: center; justify-content: center; padding: clamp(24px, 5vw, 72px); }
.auth-mobile-brand { align-self: flex-start; margin-bottom: 64px; }
.auth-form { width: 100%; max-width: 380px; border: 0; border-radius: 0; background: transparent; }
.auth-form h1 { font-size: clamp(1.9rem, 3vw, 2.5rem); }
.auth-form input { background: var(--panel); }
.auth-form .password-control { background: var(--panel); }
.auth-footer { margin-top: 36px; font-size: 12px; color: var(--muted); }

.workspace-shell { min-height: 100dvh; }
.workspace-sidebar { display: flex; flex-direction: column; gap: 28px; padding: 24px; border-bottom: 1px solid var(--border); background: #12161e; }
.workspace-brand { display: flex; align-items: center; gap: 12px; }
.workspace-nav { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 4px; scrollbar-width: thin; }
.nav-group { flex-shrink: 0; }
.nav-group-label { display: none; }
.nav-items { display: flex; gap: 4px; }
.nav-link { display: flex; min-height: 44px; align-items: center; gap: 11px; border-radius: 8px; padding: 10px 12px; font-size: 13px; font-weight: 500; color: var(--muted); white-space: nowrap; transition: background 150ms, color 150ms; }
.nav-link:hover { background: var(--secondary); color: var(--foreground); }
.nav-link-active { background: #23223d; color: #c7caff; }
.nav-link-active:hover { background: #2d2b4e; }
.sidebar-note { display: none; }
.workspace-topbar { display: flex; min-height: 80px; align-items: center; justify-content: space-between; gap: 16px; border-bottom: 1px solid var(--border); padding: 16px clamp(20px, 3vw, 44px); background: #12161e; }
.workspace-breadcrumb { display: flex; min-width: 0; align-items: center; gap: 10px; font-size: 12px; color: var(--muted); }
.workspace-breadcrumb strong { overflow: hidden; color: var(--text); font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
.workspace-identity { display: flex; flex-shrink: 0; align-items: center; gap: 10px; }
.workspace-avatar { display: grid; width: 34px; height: 34px; flex-shrink: 0; place-items: center; border: 1px solid #4c4a82; border-radius: 50%; background: #24223b; color: #c7caff; font-size: 12px; font-weight: 600; }
.workspace-user { display: none; }
.workspace-main { width: 100%; max-width: 1440px; margin-inline: auto; padding: clamp(24px, 3.1vw, 44px) clamp(20px, 3vw, 44px); }
.workspace-main > div > div:first-child h1 { margin-top: 10px; }
.dashboard-heading { margin-bottom: 32px; }
.dashboard-stats { display: grid; gap: 16px; margin-bottom: 28px; }
.dashboard-stat { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; padding: 24px; }
.stat-value { margin-top: 12px; font-size: clamp(2rem, 3vw, 2.75rem); font-weight: 500; line-height: 1; letter-spacing: -0.05em; }
.stat-icon { display: grid; width: 38px; height: 38px; flex-shrink: 0; place-items: center; border-radius: 10px; background: #24223b; color: #a5adff; }
.status-positive { border-color: #285846; background: #162a24; color: #75dcb4; }
.status-warning { border-color: #655333; background: #2c261b; color: #f4cf83; }
.status-negative { border-color: #76404e; background: #321e27; color: #ff9eae; }
.status-neutral { border-color: #424d61; background: #191f2a; color: #c1cadc; }

@media (min-width: 640px) {
  .workspace-user { display: block; max-width: 130px; }
  .dashboard-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
@media (min-width: 1024px) {
  .auth-page { grid-template-columns: 1fr 1fr; }
  .auth-story { display: flex; flex-direction: column; padding: clamp(40px, 5vw, 80px); border-right: 1px solid #262f3d; }
  .auth-mobile-brand { display: none; }
  .workspace-shell { display: grid; grid-template-columns: 236px minmax(0, 1fr); align-items: start; }
  .workspace-sidebar { position: sticky; top: 0; height: 100dvh; gap: 44px; border-right: 1px solid var(--border); border-bottom: 0; padding: 32px 20px 24px; overflow-y: auto; }
  .workspace-brand { padding-inline: 10px; }
  .workspace-nav { display: grid; gap: 28px; overflow: visible; }
  .nav-group-label { display: block; margin-bottom: 10px; padding-inline: 12px; font-size: 10px; font-weight: 600; letter-spacing: 0.09em; text-transform: uppercase; color: #a7b2c8; }
  .nav-items { display: grid; gap: 4px; }
  .sidebar-note { display: block; margin-top: auto; padding: 20px 12px 0; border-top: 1px solid var(--border); font-size: 11px; line-height: 1.7; color: var(--muted); }
}
@media (max-width: 639px) {
  .workspace-breadcrumb > span { display: none; }
  .workspace-sidebar { gap: 22px; padding: 20px 20px 12px; }
  .dashboard-stat { padding: 20px; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
}
