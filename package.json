    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "mysql2": "^3.24.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
