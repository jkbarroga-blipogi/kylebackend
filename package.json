  "main": "dist/main.js",
  "scripts": {
    "test": "vitest run",
    "test:backend": "vitest run --exclude test/frontend.*",
    "test:frontend": "vitest run test/frontend.contracts.spec.js test/frontend.browser.spec.js",
    "preview": "node scripts/preview.mjs",
    "migrate": "node scripts/migrate.mjs",
    "migrate:adopters": "node scripts/migrate-adopters.mjs",
    "build": "nest build && node -e \"const fs=require('fs');fs.mkdirSync('dist/src',{recursive:true});fs.writeFileSync('dist/src/main.js','require(\\\"../main.js\\\");\\n');\"",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch"
  },
