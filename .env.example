# Copy to .env and fill in every value. Nothing in this file is a real secret.

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false

PORT=3000

# Comma-separated allowed browser origins (for example: https://your-app.vercel.app,http://localhost:3001)
CORS_ORIGINS=

# Generate distinct 32+ byte secrets (for example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=

ACCESS_TOKEN_EXPIRES_IN=3600s
REFRESH_TOKEN_EXPIRES_IN=7d
